---
const features = [
  {
    title: '多 Profile 统一管理',
    desc: '为不同大模型供应商保存 Base URL、API Key、接口类型与模型列表，在终端 TUI 或 Web 中随时自由切换。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="21" y2="21"/><line x1="4" x2="20" y1="3" y2="3"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="12" x2="12" y1="21" y2="15"/><line x1="12" x2="12" y1="9" y2="3"/><line x1="18" x2="18" y1="15" y2="9"/><line x1="6" x2="6" y1="15" y2="9"/></svg>`,
    color: 'bg-indigo-50 text-indigo-600'
  },
  {
    title: '智能路由与 Compat Proxy',
    desc: '根据目标 Agent 期望与上游服务协议自动决定直连或启动本地网关，支持 Responses、Messages、Chat、Gemini 互转。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
    color: 'bg-purple-50 text-purple-600'
  },
  {
    title: '临时沙盒与安全隔离',
    desc: '使用临时 HOME 符号链接镜像机制启动 Agent，主系统默认配置与 OAuth Token 始终不受污染，保护密钥安全。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>`,
    color: 'bg-emerald-50 text-emerald-600'
  },
  {
    title: '集中式 MCP Server 编排',
    desc: '统一添加、启用、禁用、导入导出及健康探测 MCP Servers，一键双向同步投影至 Codex 与 Claude Code 配置。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>`,
    color: 'bg-amber-50 text-amber-600'
  },
  {
    title: '跨 Agent Skills 投影系统',
    desc: '支持从本地目录、Git 仓库或 Catalog 安装 Skill，自动同步投影至 .agents、.codex 与 .claude skills 目录。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
    color: 'bg-rose-50 text-rose-600'
  },
  {
    title: '精确 Token 消耗与计费分析',
    desc: '本地零依赖记录兼容代理的 Token 请求用量，按 Today / 7D / 30D / All 等周期实时汇总展示请求成本。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>`,
    color: 'bg-blue-50 text-blue-600'
  }
];
---

<section id="features" class="py-20 bg-slate-50 border-t border-slate-200/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest font-bold text-indigo-600 mb-2">Feature Highlights</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">打造现代化 Agent 基础设施</p>
      <p class="mt-3 text-slate-600 text-sm sm:text-base">六大核心亮点，全方位赋能你的日常 AI 智能编程体验。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feat) => (
        <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class={`h-12 w-12 rounded-xl flex items-center justify-center mb-5 ${feat.color}`} set:html={feat.icon} />
          <h3 class="text-lg font-bold text-slate-900 mb-2">{feat.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{feat.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
