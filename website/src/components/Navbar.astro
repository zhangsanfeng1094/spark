<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/85 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="h-9 w-9 rounded-xl bg-slate-900 flex items-center justify-center text-white shadow-md shadow-slate-900/10 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xl font-extrabold tracking-tight text-slate-900">Spark</span>
        <span class="text-xs px-2 py-0.5 font-semibold bg-indigo-50 text-indigo-600 border border-indigo-200/60 rounded-full">v0.13.1</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
      <a href="#about" class="hover:text-indigo-600 transition-colors">产品介绍</a>
      <a href="#features" class="hover:text-indigo-600 transition-colors">功能亮点</a>
      <a href="#demo" class="hover:text-indigo-600 transition-colors">界面展示</a>
      <a href="#download" class="hover:text-indigo-600 transition-colors">安装下载</a>
      <a href="#faq" class="hover:text-indigo-600 transition-colors">常见问题</a>
      <a href="#contact" class="hover:text-indigo-600 transition-colors">社区联系</a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <a href="https://linux.do/" target="_blank" rel="noreferrer" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        <span>LINUX DO 社区</span>
      </a>
      <a href="#download" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-sm transition-all active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
        <span>即刻起步</span>
      </a>
    </div>
  </div>
</header>
